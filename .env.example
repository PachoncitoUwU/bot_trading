# ==============================================================================
# TRADING BOT CONFIGURATION
# ==============================================================================

# Mode: PAPER | TESTNET | LIVE
BOT_MODE=PAPER

# Exchange Selection: binance | bybit | okx | kucoin
EXCHANGE_ID=binance

# Exchange API Credentials (Leave empty for PAPER mode)
# IMPORTANT: DO NOT ENABLE WITHDRAWAL PERMISSIONS ON YOUR API KEYS!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=
USE_TESTNET=true

# Trading Symbols (comma separated)
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAME=1h

# Risk Management
MAX_DAILY_DRAWDOWN_PCT=3.0
MAX_ACCOUNT_EXPOSURE_PCT=20.0
MAX_RISK_PER_TRADE_PCT=1.0
CIRCUIT_BREAKER_MAX_ERRORS=3

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_SIGNAL_TTL_SECONDS=45
TELEGRAM_HEARTBEAT_MINUTES=60

# Server & Database
APP_ENV=development
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db
